# RNF-06.3 — Configuración por variables de entorno (no hardcodeado)
VITE_API_BIOAGRO_URL=https://api.bioagro.example
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap
VITE_CORREO_FROM=no-reply@bioagro.cr
# URL pública del Grafana del stack (make dev-full lo deja en :3000,
# o en $GRAFANA_PORT si el 3000 está ocupado en tu host).
VITE_GRAFANA_URL=http://localhost:3000
# UID del dashboard a incrustar (debe existir en Grafana).
VITE_GRAFANA_DASHBOARD_UID=agrivision-detecciones
